<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ZipDown.App.MainWindow"
        Width="1150" Height="740" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">
  <DockPanel>
    <!-- 工具列 -->
    <Border DockPanel.Dock="Top" Padding="8,6" BorderThickness="0,0,0,1" BorderBrush="#33888888">
      <WrapPanel Orientation="Horizontal">
        <TextBlock x:Name="EngineLabel" VerticalAlignment="Center" Margin="0,0,6,0" />
        <ComboBox x:Name="EngineBox" Width="120" Margin="0,0,10,0" VerticalAlignment="Center" />
        <Button x:Name="AddFilesBtn" Classes="tool" />
        <Button x:Name="AddFolderBtn" Classes="tool" />
        <Button x:Name="RemoveBtn" Classes="tool" />
        <Button x:Name="ClearBtn" Classes="tool" />
        <Button x:Name="UndoBtn" Classes="tool" />
        <Border Width="1" Height="26" Background="#55888888" Margin="8,0" VerticalAlignment="Center" />
        <Button x:Name="StartBtn" Classes="tool accent" />
        <Button x:Name="StopBtn" Classes="tool" />
        <Button x:Name="SettingsBtn" Classes="tool" />
        <Button x:Name="AboutBtn" Classes="tool" />
      </WrapPanel>
    </Border>

    <Grid RowDefinitions="*,6,210">
      <!-- 任務表 -->
      <Panel Grid.Row="0">
        <DataGrid x:Name="TaskGrid"
                  AutoGenerateColumns="False"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="False"
                  CanUserSortColumns="False"
                  SelectionMode="Extended"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" />
        <TextBlock x:Name="DropHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Opacity="0.55" FontSize="16" IsHitTestVisible="False" />
      </Panel>

      <GridSplitter Grid.Row="1" ResizeDirection="Rows" Background="#33888888" />

      <!-- 紀錄區 -->
      <Border Grid.Row="2" Background="#1E1E1E">
        <ListBox x:Name="LogList" Background="Transparent" Padding="4">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="4,1" />
              <Setter Property="MinHeight" Value="0" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <SelectableTextBlock Text="{Binding Text}" Foreground="{Binding Brush}"
                                   FontFamily="Consolas,Microsoft JhengHei,Microsoft YaHei,monospace"
                                   FontSize="13" TextWrapping="Wrap" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </Grid>
  </DockPanel>
</Window>
